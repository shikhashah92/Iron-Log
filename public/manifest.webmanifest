{
  "name": "Uplift",
  "short_name": "Uplift",
  "description": "A private, offline-first training log.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F7F7F5",
  "theme_color": "#1D2125",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Resume workout",
      "short_name": "Resume",
      "description": "Open the workout in progress",
      "url": "./active",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Start a workout",
      "short_name": "Workout",
      "description": "Pick a template or start an empty workout",
      "url": "./workout",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Log weight",
      "short_name": "Weigh in",
      "description": "Log today's weigh-in",
      "url": "./weigh-in",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
